    } catch {}
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    root.dataset.homeIntro = homeIntroSeen || reduceMotion ? "skip" : "pending";

    // The About portrait is generated once per session; hold it back
    // before first paint so it never flashes ahead of the agent.
    let aboutCameoPlayed = true;
    try {
      aboutCameoPlayed =
        sessionStorage.getItem("portfolio-agent-cameo:about") === "true";
    } catch {}
    if (location.pathname === "/about" && !aboutCameoPlayed && !reduceMotion) {
      root.dataset.agentCameo = "pending";
    }
    root.classList.toggle("dark", theme === "dark");
    root.style.colorScheme = theme === "dark" ? "dark" : "light";
  } catch {}
})();
